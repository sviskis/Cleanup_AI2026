# ---------------------------------------------------------------------------
# Cleanup AI 2026 - files that must not enter version control
# ---------------------------------------------------------------------------

# runtime output (the folders themselves are re created by the script/tools)
logs/*
temp/*
output/*
runtime/*
*.log
*.tmp

# disposable render cache (JOB/.cache/preview) - safe to delete, never committed
**/.cache/

# keep the folder markers and documentation of ignored runtime folders
!logs/.gitkeep
!logs/README.md

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp*/
.pytest_cache*/
.coverage
htmlcov/

# packaging artifacts (tools/build_release.ps1 recreates them)
build/
dist/
*.spec.tmp

# Illustrator / system junk
*.bak
*.autosave
*.ai.bak
desktop.ini
Thumbs.db
.DS_Store

# editors / environment
.vscode/settings.json
.idea/
.env
secrets.*

# ---------------------------------------------------------------------------
# Legacy working copies kept in the project root.
# Byte identical copies (SHA256 verified) are committed under archive/original/,
# see archive/original/ARCHIVE_MANIFEST.md. They stay on disk untouched so the
# original reference script is always available next to the new project.
# Remove these two lines if you want the loose copies tracked as well.
# ---------------------------------------------------------------------------
/PDF_Deep_Cleanup_AI_Template_BATCH.jsx
/PDF_Deep_Cleanup_AI_Template_BATCH/

# product files must never be committed (they are the reason the tool exists)
*.pdf
*.indd
*.idml
